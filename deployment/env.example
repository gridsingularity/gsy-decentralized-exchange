# Per-host configuration for the gsy-node four-node-poa deployment.
# Copy to /etc/gsy/env and edit for each host. Referenced by the systemd units.

# Human-readable node name (shows up in logs / telemetry).
GSY_NAME=validator-1

# Chain spec. Use "four-node-poa" only while testing with the built-in dev keys.
# For a real deployment point this at the raw spec built with your own keys:
#   GSY_CHAIN=/etc/gsy/four-node-poa.raw.json
GSY_CHAIN=four-node-poa

# This node's address on the VPN (WireGuard/Tailscale) interface.
GSY_VPN_IP=10.0.0.1

# Space-separated reserved peers: the OTHER nodes, as full multiaddrs including
# their stable PeerId. Example:
#   GSY_RESERVED_NODES="/ip4/10.0.0.2/tcp/30333/p2p/12D3Koo... /ip4/10.0.0.3/tcp/30333/p2p/12D3Koo..."
GSY_RESERVED_NODES=""
