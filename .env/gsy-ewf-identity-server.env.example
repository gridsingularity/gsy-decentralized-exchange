# -----------------------------------------------------------------------------
# gsy-ewf-identity-server — EWF DID / verifiable-credential service.
#
# Repo convention: copy this file to .env/gsy-ewf-identity-server.env (gitignored)
# and fill in the blanks. Only the three values marked SECRET are blank here; the
# rest carry the same defaults the code uses.
#
# NOTE on docker-compose.central.yml: MONGODB_URI and API_KEY are also set inline
# in the compose file (env_file cannot do ${...} substitution, and inline wins over
# env_file), so what you put here for those two is ignored in that deployment.
# -----------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=production

# MongoDB. In the central/local-demo stacks this points at the existing rs0
# replica set with its own database (identitydb) — no separate mongo is deployed.
#   mongodb://gsy:gsy@mongo1:27017,mongo2:27017,mongo3:27017/identitydb?authSource=admin&replicaSet=rs0
MONGODB_URI=

# Energy Web Chain (Volta). REACHABILITY IS A HARD STARTUP DEPENDENCY:
# DIDService.onModuleInit (src/did/did.service.ts:32-60) makes two live RPC calls at
# boot — provider.getNetwork() and identityOwner(ZeroAddress) — so an unreachable or
# wrong EWC_RPC_URL prevents the service from starting at all, not just from serving
# chain-backed routes. (Measured 2026-09-06.)
EWC_RPC_URL=https://volta-rpc.energyweb.org
DID_REGISTRY_ADDRESS=0xc15d5a57a8eb0e1dcbe5d88b8f9a82017e5cc4af

# SECRET. The credential issuer's secp256k1 key, and its matching public key.
# MUST be a valid NON-ZERO secp256k1 private key. The placeholder committed in
# gsy-ewf-identity-server/.env.example:11-12 is 32 zero bytes; @ew-did-registry's
# `new Keys()` rejects it and the service will not boot if you paste it in here.
# (Measured 2026-09-06.) Generate with e.g. `openssl rand -hex 32` and derive the
# public key from it; on-chain registration (phase 3) additionally needs it funded
# with Volta VT.
ISSUER_PRIVATE_KEY=
ISSUER_PUBLIC_KEY=

# Substrate node used by the human credential flow (gsyDexAddress signature check).
SUBSTRATE_WS_URL=ws://gsy-node:9944

# SECRET. JWT signing key for the human DID-auth flow. Defaults to 'supersecret'
# in code (src/config/configuration.ts) — never ship that.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Machine-to-machine API key, required on the x-api-key header of every
# /asset-dids route and of POST /did. Deliberately the SAME key and value that
# gsy-offchain-storage and gsy-community-client use, so no new secret has to be
# distributed. The service REFUSES TO BOOT if this is unset or empty (ApiKeyGuard
# fails closed — it does not copy the storage's allow-all-on-empty branch).
# IDENTITY_API_KEY, if set, takes precedence, so the keys can be split later
# without a code change.
API_KEY=fedecom_user

# -----------------------------------------------------------------------------
# SECRET. Master seed for per-asset / per-community HD key derivation.
# Hex, 32-64 bytes. The service refuses to start if it is unset, non-hex or short.
#
# Operating rules (plan §6.2 — these are the whole mitigation for R1/R2):
#  1. Generate once with a CSPRNG: `openssl rand -hex 32`. Never a passphrase.
#  2. Back it up OUT OF BAND (password manager / KMS). It, not Mongo, is the real
#     source of truth for every asset identity: seed + ontology regenerates every
#     DID byte-identically, so Mongo is a cache and this value is not.
#  3. Never log it, never return it over HTTP, never put it in an audit record.
#  4. Rotating it changes EVERY asset and community DID. Treat rotation as a
#     migration, not an operation.
#  5. Use a distinct value per environment, so dev DIDs can never collide with
#     production ones.
#
# Losing it loses every asset DID permanently; leaking it compromises every asset
# key. This concentration of risk is accepted for the pilot (plan §2.1, §6.2).
# -----------------------------------------------------------------------------
ASSET_DID_MASTER_SEED=

# Stamped onto every derived record so a scheme change is explicit and auditable.
# Only version 1 is implemented; bumping it is a migration.
ASSET_DID_DERIVATION_VERSION=1
