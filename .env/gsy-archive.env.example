# =============================================================================
# gsy archive node (Host A) — RUNTIME configuration
# docker-compose.node-1.yml env_file
# =============================================================================
# The archive is NOT a validator: no --validator, no session keys, no account.
# It keeps full history (--state-pruning archive --blocks-pruning archive) and is
# the only resync source once the validators prune. It must run from genesis —
# --blocks-pruning 1000 on the validators keeps only ~4h of block bodies at 15s,
# and history missed in that window cannot be recovered.
#
# It shares the tailscale-node-1 sidecar's netns with validator #1, so it uses
# DIFFERENT PORTS on the SAME tailnet IP: p2p 30334, rpc 9945.
#
# First boot: generate its own libp2p key (a distinct PeerId from the validator):
#   mkdir -p .secrets/gsy-archive
#   ./target/release/gsy-node key generate-node-key --file .secrets/gsy-archive/node.key
# -----------------------------------------------------------------------------

# Human-readable name in logs.
GSY_NAME=archive

# Chain spec. Must be the SAME raw spec as both validators — verify the sha256.
# "poa" (built-in dev keys) is for testing only.
GSY_CHAIN=/chainspec/poa.raw.json

# THIS host's TAILSCALE IP (docker exec tailscale-node-1 tailscale ip -4).
# Same value as .env/gsy-node-1.env — one sidecar, one IP, two ports.
# Advertised as --public-addr on port 30334. Leave empty on the first boot.
GSY_PUBLIC_IP=

# The OTHER nodes as full multiaddrs, space-separated. For the archive that is
# BOTH validators — it needs them to sync, and they need it listed too
# (--reserved-only means an unlisted peer is invisible in both directions).
#   /ip4/<host A tailnet ip>/tcp/30333/p2p/<validator-1 PeerId>
#   /ip4/<host B tailnet ip>/tcp/30333/p2p/<validator-2 PeerId>
# Leave empty on the first boot, then fill in.
GSY_RESERVED_NODES=

# NOTE: TS_AUTHKEY is not set here — it belongs to the sidecar. Export it in the
# shell before `up`:  export TS_AUTHKEY=tskey-...
