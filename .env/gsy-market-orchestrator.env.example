RUST_LOG=info,gsy_market_orchestrator=debug
GSY_NODE_URL=ws://gsy-node:9944
ORCHESTRATOR_SIGNER_SURI=//Alice
OFFCHAIN_STORAGE_URL=http://gsy-offchain-storage:8080
TICK_INTERVAL_SECONDS=60
LOOK_AHEAD_HOURS=24
# Market-window trio — MUST stay identical across community-client / orchestrator /
# execution-engine so every service computes the same open/close windows.
TIME_SLOT_SEC=900
SPOT_MARKET_OPEN_OFFSET_MIN=-180
SPOT_MARKET_CLOSE_OFFSET_MIN=-60

# API key sent as the x-api-key header to the off-chain storage (must match its API_KEY).
API_KEY=
