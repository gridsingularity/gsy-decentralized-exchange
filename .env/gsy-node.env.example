RUST_LOG=info
CARGO_HOME=/var/www/gsy-node/.cargo
OFFCHAIN_STORAGE_URL=http://gsy-offchain-storage:8080

# NOTE: the offchain worker reads this at COMPILE time via option_env! (baked in gsy-node/Dockerfile).
# This runtime entry is for consistency/visibility only; changing it here does NOT change the worker key.
API_KEY=
