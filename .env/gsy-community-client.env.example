RUST_LOG=info
# -----------------------------------------------------------------------------
# Real external FEDECOM forecaster / measurement endpoints.
# Defaults below mirror gsy-community-client/src/constants.rs. Fill in the
# credentials before running (see the *_API_KEY / *_TOKEN fields).
# NOTE: these are reached over the public internet at runtime — the container
# needs outbound HTTPS (and any VPN/allowlisting the FEDECOM hosts require).
# -----------------------------------------------------------------------------
FEDECOM_ONTOLOGY_URL=https://fedecom.tekniker.es/services/queries/get_lecs_buildings
FEDECOM_ONTOLOGY_ASSETS_URL=https://fedecom.tekniker.es/services/queries/get_assets

FEDECOM_INFLUX_DB_URL=https://fedecom.imp.bg.ac.rs/influxdb/api/v2/query
FEDECOM_INFLUX_DB_ORG=fedecom
# REQUIRED — no default; the client cannot query InfluxDB without it.
FEDECOM_INFLUX_DB_TOKEN=

FEDECOM_DEMAND_FORECAST_URL=https://fedecom.imp.bg.ac.rs/demand_forecaster/forecast/gd_lic
FEDECOM_DEMAND_FORECAST_API_KEY=

FEDECOM_PV_FORECAST_URL=https://fedecom.imp.bg.ac.rs/pv_forecaster_aic/forecast/pv_aic
FEDECOM_PV_FORECAST_API_KEY=

# AIC demand forecaster — endpoint URL not yet finalized upstream (constants.rs
# defaults it to empty). Set it once available; leave blank to skip AIC.
FEDECOM_AIC_FORECAST_URL=
FEDECOM_AIC_FORECAST_API_KEY=

# Order loop / pricing knobs (defaults from src/constants.rs).
ORDER_RESUBMISSION_INTERVAL_SEC=300
MIN_ORDER_RATE=0.07
MAX_ORDER_RATE=0.30
PV_SPREAD_NORM=1.0
PV_MIN_CONFIDENCE=0.1
PV_MIN_FORECAST_KWH=0.05
# Risk appetite applied to the p5..p95 forecast band, in [-1.0, +1.0]. One uniform scale
# for both sides of the market:
#   -1.0 = maximally conservative (offer sells ~p5, bid buys ~p95)
#    0.0 = neutral, the point forecast, on both sides
#   +1.0 = maximally optimistic   (offer sells ~p95, bid buys ~p5)
# Which tail counts as conservative differs per side; the client handles that internally,
# so you never encode it in the sign here. The two sides stay separately tunable because
# they face different forecast uncertainty.
OFFER_RISK_FACTOR=-1.0
BID_RISK_FACTOR=-1.0
HTTP_REQUEST_TIMEOUT_SEC=60
PV_HTTP_REQUEST_TIMEOUT_SEC=150
HTTP_CONNECT_TIMEOUT_SEC=10
# Market-window trio — MUST stay identical across community-client / orchestrator /
# execution-engine so every service computes the same open/close windows.
TIME_SLOT_SEC=900
SPOT_MARKET_OPEN_OFFSET_MIN=-180
SPOT_MARKET_CLOSE_OFFSET_MIN=-60

# API key sent as the x-api-key header to the off-chain storage AND to the EWF identity
# server (must match the API_KEY configured on both — they deliberately share one key).
API_KEY=

# Base URL of the gsy-ewf-identity-server, which mints one did:ethr per ontology asset and
# per community. Unreachable is survivable: the sync loop logs and retries next tick, and
# forecast ingestion / order publication are unaffected.
IDENTITY_SERVER_URL=http://gsy-ewf-identity-server:3000
# How often (seconds) the full asset/community subject set is pushed to the identity
# server. The sync is idempotent, so an unchanged ontology creates nothing.
ASSET_DID_SYNC_INTERVAL_SEC=3600
