# One-shot on-chain registration for the demo. See deployment/bootstrap/README.md.
NODE_URL=ws://gsy-node:9944
SUDO_SURI=//Alice
# Accounts registered as trading users (the community client signs as //Alice).
REGISTER_USER_SURIS=//Alice
# Exchange-operator account (the market orchestrator's signer); defaults to sudo.
OPERATOR_SURI=//Alice
# Collateral (Planck) each trading user's vault is topped up to; without it every
# order is rejected with InsufficientCollateral. 0 disables the deposit step.
COLLATERAL_DEPOSIT=500000000000000
CONNECT_RETRIES=60
