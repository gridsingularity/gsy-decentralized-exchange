RUST_LOG=info
APPLICATION_HOST=0.0.0.0
APPLICATION_PORT=8080
DATABASE_NAME=orderbook
DATABASE_HOST=mongo1:27017,mongo2:27017,mongo3:27017
DATABASE_REPLICA_SET=rs0
DATABASE_AUTH_SOURCE=admin
DATABASE_URL_SCHEME=mongodb
DATABASE_USERNAME=gsy
DATABASE_PASSWORD=gsy
NODE_URL=gsy-node:9944
SCHEDULER_INTERVAL=900

# API key required on the x-api-key header of every request (empty string disables auth).
API_KEY=fedecom_user

# Pilot-instance parameters stamped onto every Annex A certificate returned by
# GET /guarantees-of-origin-measurements. Every one has a working default in the binary
# (certificates/config.rs), so the service starts without them — which is exactly why the
# three marked below must be set deliberately rather than left to fall through.
GOO_SITE_ID=ch-aem-lic-goo-poc
GOO_INTERVAL_DURATION_S=900
GOO_ROUNDING_RULE=half_up_2dp
GOO_GRID_OPERATOR_ID=AEM
GOO_PROPERTY_MEASURED=measurement#active_energy

# CONFIRM WITH AEM. Annex A.1 leaves the official municipality code to be inserted; 5226 is
# Capriasca, and is what openapi.yaml commits to.
GOO_MUNICIPALITY_CODE=5226
# CONFIRM PER CONNECTION POINT. 7 is taken from the Annex A.6.1 worked example only.
GOO_GRID_LEVEL=7
# PLACEHOLDER. A real DID is to be assigned by AEM; shipping the default would stamp
# "did:example:" onto production certificates.
GOO_DATA_PROVIDER_ID=did:example:aem-metering
