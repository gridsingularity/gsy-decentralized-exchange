# =============================================================================
# gsy-node validator #1 — RUNTIME configuration (docker-compose.node-1.yml env_file)
# =============================================================================
# Only runtime validator flags live here (read by the container entrypoint via
# env_file — docker parses these literally, so values may contain spaces, no
# quoting needed).
#
# The COMPILE-TIME settings (storage URL + api key the offchain worker bakes in)
# are image BUILD ARGS, not runtime env — set them for the build only:
#
#   OFFCHAIN_STORAGE_URL=http://storage.example:8080 API_KEY=<key> \
#     docker compose -f docker-compose.node-1.yml up --build
#
# (They default to http://gsy-offchain-storage:8080 / fedecom_user. NODE_BUILD_FEATURES
# is hardcoded to "--features poa" in the compose file.)
#
# First boot: generate this node's libp2p key for a stable PeerId, then exchange
# PeerIds between the two nodes (fill GSY_RESERVED_NODES on each):
#   mkdir -p .secrets/gsy-node-1
#   docker run --rm -v "$PWD/.secrets/gsy-node-1:/keys" --entrypoint \
#     /var/www/gsy-node/target/release/gsy-node <node-image> \
#     key generate-node-key --file /keys/node.key
# -----------------------------------------------------------------------------

# Chain spec. "poa" uses the built-in dev keys (Alice/Bob) — for testing only.
# For production, build a raw spec with your own keys and set an absolute path to it.
GSY_CHAIN=poa

# Validator identity. "--alice" injects the well-known poa dev session keys and marks
# this node a validator — ready to run. For real keys, set (no quotes needed):
#   GSY_VALIDATOR=--validator --name my-validator
# and insert your aura/grandpa session keys into the keystore separately.
GSY_VALIDATOR=--alice

# THIS node's TAILSCALE IP (docker exec tailscale-node-1 tailscale ip -4). Advertised as
# --public-addr so node #2 can dial it over the mesh. Leave empty on the first boot.
GSY_PUBLIC_IP=

# Node #2 as a full multiaddr over the tailnet: /ip4/<node-2 tailscale ip>/tcp/30333/p2p/<PeerId>.
# Space-separated if more than one. Leave empty on the first boot, then fill it in.
#   e.g. GSY_RESERVED_NODES=/ip4/100.101.102.103/tcp/30333/p2p/12D3KooW...
GSY_RESERVED_NODES=

# NOTE: the Tailscale auth key (TS_AUTHKEY) is NOT set here — it is a compose/build
# variable for the sidecar. Export it in the shell before `up`:  export TS_AUTHKEY=tskey-...
