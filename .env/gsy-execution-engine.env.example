RUST_LOG=info
# Minutes into the PAST the engine judges (it evaluates `now - EXECUTION_ENGINE_OFFSET_MIN`).
# 1440 = 24 h back, so the (late-arriving) metering for the slot exists. Negative values look
# into the future; only docker-compose.test.yml uses that, for e2e.
EXECUTION_ENGINE_OFFSET_MIN=1440
# Market-window trio — MUST stay identical across community-client / orchestrator /
# execution-engine so every service computes the same open/close windows.
TIME_SLOT_SEC=900
SPOT_MARKET_OPEN_OFFSET_MIN=-180
SPOT_MARKET_CLOSE_OFFSET_MIN=-60

# API key sent as the x-api-key header to the off-chain storage (must match its API_KEY).
API_KEY=
