# Copy to .env.ewds.local and load it with:
# docker compose --env-file .env.ewds.local -f docker-compose.ewds.yml up --build
#
# This compose file runs a local DDHub Client Gateway against EWF-hosted EWC
# Digital Spine services. It does not run a local broker, local IAM chain, or
# local SSI hub.

# Enable EWDS transport for DEX read-path services when the full DEX overlay is used.
OFFCHAIN_STORAGE_TRANSPORT=ewds
EWDS_ENABLE_HANDLER=true

# EWF-hosted DDHub / IAM / EWC services.
EWDS_BROKER_BASE_URL=https://ddhub-ewc.energyweb.org
EWDS_CACHE_SERVER_URL=https://identitycache.energyweb.org/v1
EWDS_EVENT_SERVER_URL=https://identitycache.energyweb.org
EWDS_RPC_URL=https://rpc.energyweb.org/
EWDS_ENS_URL=https://rpc.energyweb.org/
EWDS_CHAIN_ID=246
EWDS_CHAIN_NAME=EWC
EWDS_PARENT_NAMESPACE=dsmb.apps.ddhub.energyweb.auth.ewc
EWDS_APPLICATION_NAMESPACE_REGULAR_EXPRESSION=\w+\.apps\..*\.(iam|auth)\.ewc
EWDS_DID_REGISTRY_ADDRESS=0xE29672f34e92b56C9169f9D485fFc8b9A136BCE4
EWDS_MTLS_ENABLED=true

# Local Client Gateway runtime.
EWDS_GATEWAY_PLATFORM=linux/amd64
# Browser/UI access goes through the local proxy:
# - http://localhost:3009
# - http://localhost:3009/docs
# Keep EWDS_GATEWAY_URL as the Docker-internal API URL used by GSY services.
EWDS_GATEWAY_URL=http://ddhub-gateway-api:3333

# Select and configure the DDHub Client Gateway secrets engine according to
# the Energy Web deployment guide. The local gateway setup uses the bundled
# HashiCorp Vault service by default.
SECRETS_ENGINE=vault
VAULT_ENDPOINT=http://vault_demo:8200
# Leave empty for the bundled local Vault. The compose vault-init service writes
# the root token to a shared volume and the gateway containers load it at startup.
VAULT_TOKEN=

# Topic contract defaults.
EWDS_REQUEST_PUBLISH_FQCN=gsy.intelligent.requests.pub
EWDS_REQUEST_SUBSCRIBE_FQCN=gsy.intelligent.requests.sub
EWDS_RESPONSE_PUBLISH_FQCN=gsy.intelligent.responses.pub
EWDS_RESPONSE_SUBSCRIBE_FQCN=gsy.intelligent.responses.sub
EWDS_TOPIC_OWNER=integration.apps.intelligent.auth.ewc
EWDS_TOPIC_VERSION=1.0.0

EWDS_OFFCHAIN_STORAGE_CLIENT_ID=gsyoffchainstorage
EWDS_MATCHING_ENGINE_CLIENT_ID=gsymatchingengine
EWDS_EXECUTION_ENGINE_CLIENT_ID=gsyexecutionengine
EWDS_ORDERS_REQUEST_TOPIC=ordersQuery
EWDS_ORDERS_RESPONSE_TOPIC=ordersQueryResponse
EWDS_TRADES_REQUEST_TOPIC=tradesQuery
EWDS_TRADES_RESPONSE_TOPIC=tradesQueryResponse
EWDS_MEASUREMENTS_REQUEST_TOPIC=measurementsQuery
EWDS_MEASUREMENTS_RESPONSE_TOPIC=measurementsQueryResponse
EWDS_FORECASTS_REQUEST_TOPIC=forecastsQuery
EWDS_FORECASTS_RESPONSE_TOPIC=forecastsQueryResponse
EWDS_OPEN_MARKETS_REQUEST_TOPIC=openMarketsQuery
EWDS_OPEN_MARKETS_RESPONSE_TOPIC=openMarketsQueryResponse
EWDS_TOPOLOGY_REQUEST_TOPIC=topologyQuery
EWDS_TOPOLOGY_RESPONSE_TOPIC=topologyQueryResponse

# DDHub broker delivery is asynchronous. Keep the matching/execution response
# timeout higher than a direct HTTP request timeout for deterministic e2e runs.
EWDS_RESPONSE_TIMEOUT_MS=60000
EWDS_RESPONSE_POLL_INTERVAL_MS=1000
EWDS_HANDLER_POLL_INTERVAL_MS=500
EWDS_HANDLER_BATCH_SIZE=100

# E2E tests still query off-chain storage HTTP APIs directly for assertions.
EWDS_OFFCHAIN_STORAGE_URL=http://gsy-offchain-storage:8080
