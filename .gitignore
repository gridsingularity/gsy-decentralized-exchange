# Generated by Cargo
# will have compiled files and executables
**/target/
# These are backup files generated by rustfmt
**/*.rs.bk

.DS_Store

# The cache for docker container dependency
.cargo
# ...but keep the repo-root workspace cargo config (shared target-dir) tracked
!/.cargo/
!/.cargo/config.toml

# The cache for chain data in container
.local

# direnv cache
.direnv

mongodb-data

.idea


# Local-demo per-service env files: ignore the real ones, keep the .example templates.
/.env/*
!/.env/*.example
