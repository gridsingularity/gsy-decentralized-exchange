{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "int.measurement.schema.v1",
  "title": "GSY Measurement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "facilityId": { "type": "string", "minLength": 1 },
    "communityUuid": { "type": "string", "minLength": 1 },
    "timeSlot": { "type": "string", "format": "date-time" },
    "creationTime": { "type": "string", "format": "date-time" },
    "energyKwh": { "type": "number" }
  },
  "required": ["facilityId", "communityUuid", "timeSlot", "creationTime", "energyKwh"]
}
