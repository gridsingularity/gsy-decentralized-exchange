{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "int.orders.query.request.v1",
  "title": "ordersQuery request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "operation": { "const": "orders.query" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marketId": { "type": "string", "not": { "enum": ["00000000-0000-0000-0000-000000000000","0x00000000000000000000000000000000","00000000000000000000000000000000"] }, "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89aAbB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}(?![\\s\\S])", "description": "Hyphenated UUIDv4 market ID; no surrounding whitespace. Reads use lowercase UUID text." },
        "startTime": { "type": "string", "format": "date-time", "description": "Inclusive range start, RFC 3339." },
        "endTime": { "type": "string", "format": "date-time", "description": "Exclusive range end, RFC 3339." }
      }
    }
  },
  "required": ["requestId", "operation", "payload"]
}
